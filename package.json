{
  "name": "excalidraw-serverless",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "web:install": "cd vendor/excalidraw && bun install --ignore-scripts",
    "web:dev": "cd vendor/excalidraw/excalidraw-app && bunx vite",
    "web:build": "cd vendor/excalidraw/excalidraw-app && VITE_APP_DISABLE_SENTRY=true bunx vite build",
    "upstream:pull": "git subtree pull --prefix vendor/excalidraw upstream master --squash"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.3.12",
    "typescript": "^7.0.2"
  }
}
